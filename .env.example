# --- Server ---
PORT=3001
# Required to open /admin. If empty, the admin area is disabled.
ADMIN_PASSWORD=adminpassword

# --- Notion storage (optional; falls back to data/responses.json) ---
# 1. Create an internal integration at https://www.notion.so/profile/integrations and copy its secret.
# 2. Create an empty Notion page, open ••• > Connections and add your integration to it.
# 3. Put the page ID below and run: npm run setup:notion  (it creates the database and prints NOTION_DATABASE_ID)
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=
